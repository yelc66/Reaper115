# Reaper115 配置模板
# 复制为 config/config.yaml 后填入自己的密钥和路径。

log_level: info

############################################Telegram##################################
bot_token: ""
allowed_user: ""

############################################115 开放平台##################################
# 填写 app_id 后可通过 Web UI 扫码授权
115_app_id: ""
access_token: ""
refresh_token: ""

############################################涩花爬虫##################################
sehuatang_spider:
  enable: false
  sync_time: "03:00"
  base_url: www.sehuatang.net
  cookie_string: ""
  sections:
    - name: 高清中文字幕
      save_path: /AV/涩花/高清中文字幕
      rules: []
      # rules 示例（留空表示该板块所有标题都下载）:
      # rules:
      #   - name: 无码字幕
      #     pattern: 无码字幕
      #     save_path: /AV/涩花/无码字幕   # 可选，覆盖板块路径
      #     kind: include   # include=包含 / exclude=排除
      #     active: true
  notify_me: true
  notify_with_image: false
  sort_by_year_month: false
  rename_by_title: true

############################################missav 爬虫##################################
# missav 是「榜单页」模式（无日期维度）：每个榜单爬前 max_items 个番号，
# 详情页有多条 magnet，按「中文字幕优先，否则容量最大」选一条。入库前用 magnet hash 去重。
# lists 已内置「今日/本周/本月」三个 views 排序榜单，按需保留或注释。
missav_spider:
  enable: false
  sync_time: "04:00"
  base_url: missav.ws
  max_items: 12           # 每个榜单爬取的番号数量上限（榜单页一页约 12 个）
  lists:
    - name: 今日热门
      path: dm296/en/today-hot   # base_url 之后的榜单路径（Today views）
      save_path: /AV/missav/今日热门
      rules: []
      # rules 与涩花同结构（留空表示该榜单所有标题都下载）:
      # rules:
      #   - name: 仅中文字幕
      #     pattern: 中文字幕
      #     save_path: /AV/missav/中文字幕   # 可选，覆盖榜单路径
      #     kind: include   # include=包含 / exclude=排除
      #     active: true
    # - name: 本周热门
    #   path: dm170/en/weekly-hot   # Weekly views
    #   save_path: /AV/missav/本周热门
    #   rules: []
    # - name: 本月热门
    #   path: dm266/en/monthly-hot  # Monthly views
    #   save_path: /AV/missav/本月热门
    #   rules: []
  notify_me: true
  notify_with_image: false
  sort_by_year_month: false
  rename_by_title: true

############################################Emby 热门合集##################################
# 把 missav 今日/本周/本月热门榜单里「Emby 库中已有」的番号同步为 Emby 合集（只抓榜单页，不下载）。
# 手动触发：TG 发送 /embyhot
emby:
  enabled: false
  url: http://192.168.1.2:8096
  api_key: ""              # Emby 控制台 → 高级 → API 密钥
  user_id: ""              # 可选
  sync_time: "05:00"
  max_items: 48            # 每个榜单取前 N 个番号（自动翻页 ?page=N）
  max_pages: 10            # 翻页上限
  # 缺失番号自动下载：上榜但 Emby 库中没有的番号，先搜涩花（中文字幕帖优先），再用 missav 详情页 magnet，
  # 提交 115 离线后走正常后处理（广告清理 → 重命名 → organize 整理）
  auto_download: false
  download_source_order: [sehuatang, missav]
  retry_days: 7            # 同一番号 N 天内只尝试一次（emby_hot_attempts 表）
  max_downloads_per_run: 10
  download_save_path: ""   # 可选：统一离线目录；留空则按来源版块/榜单 save_path
  missav_list_name: Emby热门补全   # missav 来源写入 missav_data 的 list_name
  collections:             # 榜单 → 合集名（删掉某行即不同步该榜单）
    today-hot: 今日热门
    weekly-hot: 本周热门
    monthly-hot: 本月热门
  # list_paths:            # 可选：覆盖榜单路径（站点取 missav_spider.base_url）
  #   today-hot: dm296/en/today-hot

############################################远程浏览器##################################
# 远程 Selenium host（留空则不使用，/wd/hub 由代码自动拼接）
remote_selenium_url: "http://chrome:4444"
# FlareSolverr host（留空则不使用，/v1 由代码自动拼接）
flaresolverr_url: ""
# true(默认): 直接用 FlareSolverr 抓取渲染后的 HTML，绕过 chrome 容器回灌 cookie 的方式
#             （推荐，解决 cf_clearance 因 IP/指纹跨容器失配导致一直卡在 Cloudflare 验证页的问题）
# false:      回退旧方案（chrome 容器 + 把 FlareSolverr 解出的 cookie 回灌刷新）
flaresolverr_fetch: true

############################################Web 管理界面##################################
web:
  enable: true
  port: 8115
  auth_key: ""

############################################按番号整理(可选)##################################
# 离线完成并清理/重命名后，按番号把正片移动到 {root}/{分类}/{番号}/，
# 并改名为 Emby 多版本格式: "MIDA-752 - C.mp4" / "MIDA-752 - UC.mp4" / "MIDA-752.mp4"
# 版本后缀: -C=中文字幕(C)  -UC=无码破解+中文字幕(UC)  -U=无码破解(U)
organize:
  enabled: false
  dry_run: true            # true 时只打印计划动作，不调用 115 写接口
  root: /涩花/整理
  api_interval_sec: 1.0    # 每次 115 API 调用之间的间隔，降低风控风险
  default_category: 未知   # 未识别的文件保留原位，不移动
  categories:              # 与 MDC-NG category_mapping 一致，按番号正则匹配，首条命中生效
    - name: FC2
      pattern: '^FC2-PPV-'
    - name: 欧美
      pattern: '^[A-Za-z][A-Za-z0-9]*\.\d{2}\.\d{2}\.\d{2}'
    - name: 日本无码
      pattern: '^(?:HEYZO-|\d{6}[-_]\d{2,3}$|[NK]\d{4}$|[HC]\d{4}-|CARIB|1PON|10MU|PACOPACOMAMA)'
    - name: 素人
      pattern: '^(?:\d{3}[A-Z]{2,6}-\d{3,5}$|SIRO-|ARA-|KNB-|DCV-|MAAN-|SCUTE-)'
    - name: 日本有码
      pattern: '^[A-Z]{2,6}-\d{2,5}$'
    # - name: 国产        # 暂无规则
    #   pattern: '...'
############################################广告清理##################################
clean_policy:
  switch: "on"
  less_than: 100M
  # 文件名包含以下任一关键词则视为广告文件，直接删除（不受 less_than 大小限制）
  # 留空列表则仅用大小过滤
  ad_name_patterns:
    - "489155.com"
    - "sexinsex"
    - "草榴社区"
    - "t66y.com"
    - "getfreeav"
    - "bbs."
    - "www."
    - "直播"
    - "位址"
    - "社区最新情报"
  # 扩展名匹配则视为广告文件，直接删除（不受 less_than 大小限制，不受 protect_largest 保护）
  ad_extensions:
    - ".html"
    - ".txt"
    - ".url"
  # 保护最大文件：目录中体积最大的文件永远不删（即使文件名命中广告模式）
  protect_largest: true
  # 去除植入正片文件名的广告前缀（形如 489155.com@DLDSS-496-C.mp4 -> DLDSS-496-C.mp4）
  # 规则：恰六位数字 + ".com@" 开头。true(默认)开启，false 关闭
  strip_ad_prefix: true
